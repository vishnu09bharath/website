# Secrets for the /admin CMS. Copy to `.dev.vars` for local use (optional — local
# dev leaves /admin open without auth). In production set these as Cloudflare
# Pages / Workers secrets. See ADMIN.md.

# Google OAuth client credentials (Web application). Scope is just openid+email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Long random string used to sign the admin session cookie. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=

# Only this Google account email may access /admin.
ALLOWED_EMAIL=mr.vishnubharath@gmail.com

# Cloudflare Workers AI REST API — used by the /news dashboard to rank stories.
# In production set with `wrangler secret put CF_ACCOUNT_ID` / `... CF_AI_TOKEN`.
CF_ACCOUNT_ID=
CF_AI_TOKEN=

# Resend (sending-only key for vishnubharath.com) — scheduled-task emails:
# reminders and failure alerts, sent from website@vishnubharath.com to ALLOWED_EMAIL.
RESEND_API_KEY=

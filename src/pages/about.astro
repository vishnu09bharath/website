---
import Base from "../layouts/Base.astro";
import Globe from "../components/Globe.astro";
import { getSite } from "../data/site";

export const prerender = false; // read travel plan from KV at request time

const description =
  "About Vishnu Bharath, a student researcher and robotics team founder.";

const { travel } = await getSite((Astro.locals as any).runtime?.env);
---

<Base title="About — Vishnu Bharath" description={description} back backLabel="Home">
  <Globe travel={travel} />

  <header>
    <h1>About</h1>
    <p class="tagline">me</p>
  </header>

  <main>
    <p class="intro">who am i?</p>

    <ul class="contact-list">
      <li><a href="mailto:mr.vishnubharath@gmail.com">mr.vishnubharath@gmail.com</a></li>
    </ul>

    <p class="photo-credit">
      © Photos by
      <a href="https://www.instagram.com/kroozemissile.nef/" rel="noopener"
        >Hector Cruz</a
      >
    </p>
  </main>
</Base>

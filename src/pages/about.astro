---
import Base from "../layouts/Base.astro";
import SectionTaskbar from "../components/SectionTaskbar.astro";

const description =
  "About Vishnu Bharath, a student researcher and robotics team founder.";
---

<Base title="About — Vishnu Bharath" description={description} back>
  <header>
    <h1>About</h1>
    <p class="tagline">Student researcher, builder, and robotics team founder.</p>
  </header>

  <main>
    <SectionTaskbar active="about" />

    <p class="intro">who am i?</p>

    <p class="photo-credit">
      © Photos by
      <a href="https://www.instagram.com/kroozemissile.nef/" rel="noopener"
        >Hector Cruz</a
      >
    </p>
  </main>
</Base>

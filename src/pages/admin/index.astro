      /* ---------- Itinerary combobox ---------- */
      .itinerary {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: start;
        gap: 0.85rem;
        margin-top: 0.85rem;
      }
      .itinerary-arrow {
        align-self: center;
        margin-top: 1.55rem; /* drop arrow down past the .lbl row */
        color: var(--muted);
        font-size: 1.1rem;
      }
      .combo {
        position: relative;
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .combo .lbl {
        display: block;
        margin-bottom: 0.3rem;
        color: var(--muted);
        font-size: 0.78rem;
      }
      .combo .lbl em {
        margin-left: 0.4rem;
        color: var(--muted);
        font-size: 0.7rem;
        font-style: normal;
        opacity: 0.8;
      }
      .combo-input {
        position: relative;
      }
      .combo-input input {
        width: 100%;
        /* leave room for the status dot so it never sits on top of text */
        padding-right: 1.75rem;
      }
      .combo-status {
        position: absolute;
        top: 50%;
        right: 0.55rem;
        width: 0.55rem;
        height: 0.55rem;
        transform: translateY(-50%);
        border-radius: 50%;
        background: transparent;
        transition: background 0.15s ease;
      }
      .combo.is-loading .combo-status {
        background: var(--muted);
        animation: pulse 1.2s ease-in-out infinite;
      }
      .combo.is-stale .combo-status {
        background: #ff8a3d;
      }
      .combo.is-fresh .combo-status {
        background: #01ed7e;
      }
      @keyframes pulse {
        0%, 100% { opacity: 0.4; }
        50% { opacity: 1; }
      }
      .combo-list {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 5;
        margin-top: 0.25rem;
        max-height: 16rem;
        overflow-y: auto;
        padding: 0.25rem;
        background: var(--bg);
        border: 1px solid var(--rule);
        border-radius: 3px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
      }
      .combo-item {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.1rem;
        width: 100%;
        padding: 0.45rem 0.6rem;
        background: transparent;
        border: 0;
        border-radius: 2px;
        color: var(--fg);
        font: inherit;
        font-size: 0.85rem;
        text-align: left;

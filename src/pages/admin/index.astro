      .combo-item:hover,
      .combo-item.is-focused {
        background: var(--rule);
      }
      .combo-item-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        width: 100%;
        gap: 0.75rem;
      }
      .combo-item-label {
        flex: 1 1 auto;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .combo-item-tag {
        flex: 0 0 auto;
        color: var(--muted);
        font-size: 0.66rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }
      .combo-item-coords {
        color: var(--muted);
        font-size: 0.72rem;
        font-variant-numeric: tabular-nums;
      }
      .combo-item.is-empty,
      .combo-item.is-loading {
        cursor: default;
        color: var(--muted);
        font-size: 0.78rem;
      }
      .combo-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.4rem;
        color: var(--muted);
        font-size: 0.72rem;
        font-variant-numeric: tabular-nums;
      }
      .combo-meta .dot {
        color: var(--rule);
      }

      .itinerary-summary {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin: 1.1rem 0 0;
        padding: 0.7rem 0.9rem;
        background: rgba(255, 255, 255, 0.025);
        border: 1px solid var(--rule);
        border-radius: 2px;
        color: var(--fg);
        font-size: 0.88rem;
      }
      .itinerary-summary .arrow-sm {
        color: var(--muted);
      }
      .itinerary-summary .dot {
        color: var(--rule);
      }
      .itinerary-summary .flight-tag {
        display: inline-flex;
        align-items: baseline;
        gap: 0.45rem;
        color: var(--muted);

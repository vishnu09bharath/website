---
export const prerender = false;

import "../../styles/global.css";
import { getSite } from "../../data/site";
import { getAdmin } from "../../lib/auth";
import { getTaskOverview, STALE_RUN } from "../../lib/tasks";
import { CITIES } from "../../data/cities";

const env = (Astro.locals as any).runtime?.env;
const login = await getAdmin(Astro.cookies, env);
if (!login) return Astro.redirect("/login");

const site = await getSite(env);
const saved = Astro.url.searchParams.get("saved");
const error = Astro.url.searchParams.get("error");
const kvMissing = !env?.SITE_KV;
const isDev = import.meta.env.DEV;

// After a save the user lands back here with ?saved=1#site (or ?error=...#site).
// We can't read the URL hash on the server, but the query param is a perfect
// hint — render the Site content tab active so there's no Overview→Site flicker
// before client JS picks up the hash.
// Task actions come back with ?task=ok|err&msg=...#tasks the same way.
const taskFlash = Astro.url.searchParams.get("task");
const taskMsg = Astro.url.searchParams.get("msg");
const initialTab = taskFlash ? "tasks" : saved || error ? "site" : "overview";

// ---------- Tasks tab ----------
const taskOverview = await getTaskOverview(env);
const now = Date.now();
function fmtTime(ms: number): string {
  const opts: Intl.DateTimeFormatOptions = {
    month: "short",
    day: "numeric",
    year: "numeric",
    hour: "numeric",
    minute: "2-digit",
  };
  try {
    return new Date(ms).toLocaleString("en-US", { ...opts, timeZone: site.travel.home.timezone });
  } catch {
    return new Date(ms).toLocaleString("en-US", opts);
  }
}
function ago(ms: number): string {
  const m = Math.round((now - ms) / 60_000);
  if (m < 1) return "just now";
  if (m < 60) return `${m}m ago`;
  if (m < 48 * 60) return `${Math.round(m / 60)}h ago`;
  return `${Math.round(m / 1440)}d ago`;
}
const duration = (ms: number) => (ms < 1000 ? `${ms}ms` : `${(ms / 1000).toFixed(1)}s`);
// Cron ticks every 15 min; three missed ticks means the scheduler isn't firing.
const schedulerStale = !isDev && now - taskOverview.heartbeatAt > 45 * 60_000;
const taskRows = taskOverview.tasks.map(({ task, state, nextRunAt }) => {
  const last = state.history[0];
  const running = state.startedAt > 0 && now - state.startedAt < STALE_RUN;
  const status = state.paused
    ? { key: "paused", label: "Paused" }
    : running
      ? { key: "running", label: "Running" }
      : state.completedAt
        ? { key: "done", label: "Done" }
        : last && !last.ok
          ? { key: "failed", label: "Failed" }
          : last
            ? { key: "ok", label: "OK" }
            : { key: "waiting", label: "Waiting" };
  const schedule =
    "every" in task.schedule
      ? `every ${task.schedule.every} min`
      : `once · ${fmtTime(Date.parse(task.schedule.once))}`;
  const next =
    nextRunAt === null ? null : nextRunAt <= now ? "next tick" : fmtTime(nextRunAt);
  return { task, state, last, status, schedule, next };
});

// Curated palettes for the announcement banner — one-click alternatives to the
// raw color pickers. First is the current default.
const BANNER_PRESETS = [
  { name: "Lime",      bg: "#01ed7e", fg: "#000000" },
  { name: "Citrus",    bg: "#ff8a3d", fg: "#000000" },
  { name: "Sunshine",  bg: "#fff200", fg: "#000000" },
  { name: "Signal",    bg: "#2f81f7", fg: "#ffffff" },
  { name: "Hot pink",  bg: "#ff3d8a", fg: "#000000" },
  { name: "Mono dark", bg: "#0a0a0a", fg: "#e8e8e4" },
  { name: "Mono lite", bg: "#f2f3f5", fg: "#131312" },
];

const arrivalDate = new Date(site.travel.arrival + "T00:00:00");
const daysToArrival = Math.max(
  0,
  Math.ceil((arrivalDate.getTime() - Date.now()) / 86400000),
);

const humanArrival = arrivalDate.toLocaleDateString("en-US", {
  weekday: "short",
  month: "short",
  day: "numeric",
  year: "numeric",
});

const fmtLat = (lat: number) =>
  `${Math.abs(lat).toFixed(4)}° ${lat >= 0 ? "N" : "S"}`;
const fmtLon = (lon: number) =>
  `${Math.abs(lon).toFixed(4)}° ${lon >= 0 ? "E" : "W"}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Dashboard — Vishnu Bharath</title>
  </head>
  <body>
    <a class="back" href="/">← Home</a>

    <header class="dash-head">
      <h1>Dashboard</h1>
      <p class="tagline">Site content and tools.</p>
      <p class="dash-who">
        {
          isDev ? (
            <span class="dash-badge">local dev · no auth</span>
          ) : (
            <>
              signed in as <span class="dash-email">{login}</span>
              <span class="sep" aria-hidden="true">·</span>
              <a href="/api/auth/logout">log out</a>
            </>
          )
        }
      </p>
    </header>

    <nav class="dash-taskbar" aria-label="Sections">
      <a
        class:list={["tab", { "is-active": initialTab === "overview" }]}
        data-tab="overview"
        href="#overview"
      >
        Overview
      </a>
      <a
        class:list={["tab", { "is-active": initialTab === "site" }]}
        data-tab="site"
        href="#site"
      >
        Site content
      </a>
      <a
        class:list={["tab", { "is-active": initialTab === "tasks" }]}
        data-tab="tasks"
        href="#tasks"
      >
        Tasks
      </a>
      <a class="tab" href="/news">News</a>
    </nav>

    <main>
      <section class="dash-pane" data-pane="overview" hidden={initialTab !== "overview"}>
        <header class="pane-head">
          <h2>Overview</h2>
          <p class="pane-sub">What's live on the site right now.</p>
        </header>

          <article class="status-panel">
            <dl class="status-list">
              <div class="status-row">
                <dt>Banner</dt>
                <dd>
                  <span class="status-state" data-on={String(site.banner.enabled)}>
                    {site.banner.enabled ? "On" : "Off"}
                  </span>
                  {
                    site.banner.enabled && (
                      <>
                        <span class="status-sep" aria-hidden="true">·</span>
                        <span class="status-text">"{site.banner.text}"</span>
                      </>
                    )
                  }
                </dd>
                <span
                  class="status-swatch"
                  aria-hidden="true"
                  style={`background:${site.banner.bg};color:${site.banner.fg}`}
                >Aa</span>
              </div>

              <div class="status-row">
                <dt>Location</dt>
                <dd>
                  {site.travel.home.label}
                  <span class="status-sep" aria-hidden="true">·</span>
                  <span class="status-text">{site.travel.home.timezone}</span>
                </dd>
              </div>

              <div class="status-row">
                <dt>Next</dt>
                <dd>
                  {site.travel.destination.label}
                  <span class="status-sep" aria-hidden="true">·</span>
                  <span class="status-text">
                    {daysToArrival === 0
                      ? "arriving today"
                      : `in ${daysToArrival} ${daysToArrival === 1 ? "day" : "days"}`}
                    · {site.travel.arrival}
                  </span>
                </dd>
              </div>

              {
                site.travel.flight && (
                  <div class="status-row">
                    <dt>Flight</dt>
                    <dd>{site.travel.flight}</dd>
                  </div>
                )
              }
            </dl>
          </article>

          <nav class="status-actions" aria-label="Quick links">
            <a href="/" target="_blank" rel="noopener">Open homepage ↗</a>
            <a href="/about" target="_blank" rel="noopener">Open globe ↗</a>
            <a href="#site">Edit content ↓</a>
          </nav>
        </section>

        <section class="dash-pane" data-pane="site" hidden={initialTab !== "site"}>
          <header class="pane-head">
            <h2>Site content</h2>
            <p class="pane-sub">
              Edit the banner and globe travel plan. Changes are live the moment
              you save — no rebuild required.
            </p>
          </header>

          {
            saved && (
              <p class="dash-toast ok">Saved. Changes are live.</p>
            )
          }
          {error && <p class="dash-toast err">Could not save: {error}</p>}
          {
            kvMissing && (
              <p class="dash-toast err">
                SITE_KV is not bound — saving is disabled. Add the KV namespace
                binding (see ADMIN.md).
              </p>
            )
          }

          <form method="POST" action="/api/admin/save" class="site-form">
            <div class="form-grid">
              <div class="form-fields">
                <fieldset class="card">
                  <legend>Announcement banner</legend>

                  <label class="toggle">
                    <input
                      id="bannerEnabled"
                      type="checkbox"
                      name="bannerEnabled"
                      checked={site.banner.enabled}
                    />
                    <span>Show on the homepage</span>
                  </label>

                  <label>
                    <span class="lbl">Lead-in <em>hidden on narrow screens</em></span>
                    <input
                      id="bannerPrefix"
                      type="text"
                      name="bannerPrefix"
                      value={site.banner.prefix}
                    />
                  </label>

                  <label>
                    <span class="lbl">Headline</span>
                    <input
                      id="bannerText"
                      type="text"
                      name="bannerText"
                      value={site.banner.text}
                      required
                    />
                  </label>

                  <div class="row">
                    <label>
                      <span class="lbl">Link label</span>
                      <input
                        id="bannerLinkLabel"
                        type="text"
                        name="bannerLinkLabel"
                        value={site.banner.linkLabel}
                        required
                      />
                    </label>
                    <label>
                      <span class="lbl">Link URL</span>
                      <input
                        id="bannerLinkHref"
                        type="url"
                        name="bannerLinkHref"
                        value={site.banner.linkHref}
                        required
                      />
                    </label>
                  </div>

                  <div class="color-section">
                    <span class="lbl">Colors</span>
                    <div class="color-controls">
                      <span class="color-field">
                        <input
                          id="bannerBg"
                          type="color"
                          name="bannerBg"
                          value={site.banner.bg}
                          aria-label="Background color"
                        />
                        <input
                          id="bannerBgHex"
                          type="text"
                          value={site.banner.bg}
                          aria-label="Background hex"
                          pattern="^#[0-9a-fA-F]{6}$"
                          maxlength="7"
                          spellcheck="false"
                        />
                        <em>Background</em>
                      </span>
                      <span class="color-field">
                        <input
                          id="bannerFg"
                          type="color"
                          name="bannerFg"
                          value={site.banner.fg}
                          aria-label="Text color"
                        />
                        <input
                          id="bannerFgHex"
                          type="text"
                          value={site.banner.fg}
                          aria-label="Text hex"
                          pattern="^#[0-9a-fA-F]{6}$"
                          maxlength="7"
                          spellcheck="false"
                        />
                        <em>Text</em>
                      </span>
                    </div>
                    <div class="color-presets" role="group" aria-label="Palette presets">
                      {
                        BANNER_PRESETS.map((p) => (
                          <button
                            type="button"
                            class="swatch"
                            data-bg={p.bg}
                            data-fg={p.fg}
                            title={p.name}
                            style={`background:${p.bg};color:${p.fg}`}
                          >
                            Aa
                          </button>
                        ))
                      }
                    </div>
                  </div>
                </fieldset>

                <fieldset class="card">
                  <legend>Itinerary</legend>

                  <div class="itinerary">
                    <div class="combo" data-scope="home">
                      <span class="lbl">
                        From <em>where you are now</em>
                      </span>
                      <div class="combo-input">
                        <input
                          id="homeLabel"
                          name="homeLabel"
                          type="text"
                          autocomplete="off"
                          spellcheck="false"
                          placeholder="Search a city or place…"
                          value={site.travel.home.label}
                          required
                        />
                        <span class="combo-status" aria-hidden="true"></span>
                      </div>
                      <div class="combo-list" role="listbox" hidden></div>
                      <div class="combo-meta">
                        <span data-meta="coords">
                          {fmtLat(site.travel.home.lat)} · {fmtLon(site.travel.home.lon)}
                        </span>
                        <span class="dot" aria-hidden="true">·</span>
                        <span data-meta="tz">{site.travel.home.timezone}</span>
                      </div>
                      <input type="hidden" id="homeLat" name="homeLat" value={site.travel.home.lat} />
                      <input type="hidden" id="homeLon" name="homeLon" value={site.travel.home.lon} />
                      <input type="hidden" id="homeTz" name="homeTz" value={site.travel.home.timezone} />
                    </div>

                    <span class="itinerary-arrow" aria-hidden="true">→</span>

                    <div class="combo" data-scope="dest">
                      <span class="lbl">
                        To <em>your destination</em>
                      </span>
                      <div class="combo-input">
                        <input
                          id="destLabel"
                          name="destLabel"
                          type="text"
                          autocomplete="off"
                          spellcheck="false"
                          placeholder="Search a city or place…"
                          value={site.travel.destination.label}
                          required
                        />
                        <span class="combo-status" aria-hidden="true"></span>
                      </div>
                      <div class="combo-list" role="listbox" hidden></div>
                      <div class="combo-meta">
                        <span data-meta="coords">
                          {fmtLat(site.travel.destination.lat)} · {fmtLon(site.travel.destination.lon)}
                        </span>
                        <span class="dot" aria-hidden="true">·</span>
                        <span data-meta="tz">{site.travel.destination.timezone}</span>
                      </div>
                      <input type="hidden" id="destLat" name="destLat" value={site.travel.destination.lat} />
                      <input type="hidden" id="destLon" name="destLon" value={site.travel.destination.lon} />
                      <input type="hidden" id="destTz" name="destTz" value={site.travel.destination.timezone} />
                    </div>
                  </div>

                  <div class="row">
                    <label>
                      <span class="lbl">
                        Arrival date <em>globe counts down to this</em>
                      </span>
                      <input
                        id="arrival"
                        type="date"
                        name="arrival"
                        value={site.travel.arrival}
                        required
                      />
                    </label>
                    <label>
                      <span class="lbl">
                        Flight <em>optional · e.g. UA853</em>
                      </span>
                      <input
                        id="flight"
                        type="text"
                        name="flight"
                        value={site.travel.flight}
                        placeholder="UA853"
                        autocomplete="off"
                        maxlength="12"
                      />
                    </label>
                  </div>

                  <p class="itinerary-summary" aria-live="polite">
                    <span id="summaryFrom">{site.travel.home.label}</span>
                    <span class="arrow-sm" aria-hidden="true">→</span>
                    <span id="summaryTo">{site.travel.destination.label}</span>
                    <span class="dot" aria-hidden="true">·</span>
                    <span id="summaryDate">{humanArrival}</span>
                    <span
                      class="flight-tag"
                      id="summaryFlight"
                      hidden={!site.travel.flight}
                    >
                      <span class="dot" aria-hidden="true">·</span>
                      <span data-bind="flight">{site.travel.flight}</span>
                    </span>
                  </p>
                </fieldset>

                <div class="actions">
                  <button type="submit" disabled={kvMissing}>
                    Save changes
                  </button>
                  <a class="view" href="/" target="_blank" rel="noopener">
                    Open homepage ↗
                  </a>
                  <a class="view" href="/about" target="_blank" rel="noopener">
                    Open globe ↗
                  </a>
                </div>
              </div>

              <aside class="form-preview" aria-label="Live preview">
                <h3>Live preview</h3>

                <div class="preview-tag">Homepage top</div>
                <div class="preview-frame" id="previewFrame">
                  <div
                    class="preview-banner"
                    id="previewBanner"
                    style={`--banner-bg:${site.banner.bg};--banner-fg:${site.banner.fg}`}
                    data-enabled={String(site.banner.enabled)}
                  >
                    <span>
                      <span class="preview-banner-prefix" data-bind="bannerPrefix">{site.banner.prefix}</span>
                      <span data-bind="bannerText">{site.banner.text}</span>
                    </span>
                    <a data-bind="bannerLink" href={site.banner.linkHref}>{site.banner.linkLabel}</a>
                  </div>
                  <div class="preview-disabled" hidden={site.banner.enabled}>
                    Banner is hidden.
                  </div>
                  <div class="preview-page">
                    <div class="preview-hero">Vishnu Bharath</div>
                    <div class="preview-page-stub" />
                  </div>
                </div>

                <div class="preview-tag">Globe panel (About page)</div>
                <div class="preview-globe">
                  <dl>
                    <div>
                      <dt>Location</dt>
                      <dd data-bind="homeLabel">{site.travel.home.label}</dd>
                    </div>
                    <div>
                      <dt>Next</dt>
                      <dd>
                        <span data-bind="destLabel">{site.travel.destination.label}</span>
                        <span class="preview-eta">in <span id="previewCountdown">--:--:--:--</span></span>
                      </dd>
                    </div>
                    <div id="previewFlightRow" hidden={!site.travel.flight}>
                      <dt>Flight</dt>
                      <dd data-bind="flightPreview">{site.travel.flight}</dd>
                    </div>
                    <div>
                      <dt>Coords</dt>
                      <dd>
                        <span id="previewHomeCoords">{fmtLat(site.travel.home.lat)} · {fmtLon(site.travel.home.lon)}</span>
                        <span class="preview-arrow"> → </span>
                        <span id="previewDestCoords">{fmtLat(site.travel.destination.lat)} · {fmtLon(site.travel.destination.lon)}</span>
                      </dd>
                    </div>
                  </dl>
                </div>
              </aside>
            </div>
          </form>
        </section>

        <section class="dash-pane" data-pane="tasks" hidden={initialTab !== "tasks"}>
          <header class="pane-head">
            <h2>Tasks</h2>
            <p class="pane-sub">
              Scheduled jobs from <code>src/tasks/</code>, run by the Worker cron every 15 min.
              {
                taskOverview.heartbeatAt
                  ? ` Scheduler last ran ${ago(taskOverview.heartbeatAt)}.`
                  : " The scheduler hasn't run yet."
              }
            </p>
          </header>

          {
            taskFlash && (
              <p class:list={["dash-toast", taskFlash === "ok" ? "ok" : "err"]}>{taskMsg}</p>
            )
          }
          {
            schedulerStale && (
              <p class="dash-toast err">
                The cron hasn't fired in over 45 minutes, so nothing runs on schedule.
                Check the Worker's cron trigger in the Cloudflare dashboard (see ADMIN.md).
              </p>
            )
          }

          <ul class="task-list">
            {
              taskRows.map(({ task, state, last, status, schedule, next }) => (
                <li class="task">
                  <div class="task-head">
                    <span class="task-state" data-state={status.key}>{status.label}</span>
                    <h3>{task.title}</h3>
                    <span class="status-text">{schedule}</span>
                  </div>
                  <p class="task-desc">{task.description}</p>
                  <p class="task-meta">
                    {last ? `Last run ${ago(last.at)} · ${duration(last.ms)} · ${last.message}` : "Never run"}
                    {next && (
                      <>
                        <span class="status-sep" aria-hidden="true">·</span>
                        Next: {next}
                      </>
                    )}
                  </p>
                  {state.history.length > 0 && (
                    <details class="task-history">
                      <summary>History</summary>
                      <ol>
                        {state.history.map((r) => (
                          <li data-ok={String(r.ok)}>
                            <time>{fmtTime(r.at)}</time>
                            <span class="run-result">
                              {r.ok ? "ok" : "failed"} · {r.trigger} · {duration(r.ms)}
                            </span>
                            <span class="status-text">{r.message}</span>
                          </li>
                        ))}
                      </ol>
                    </details>
                  )}
                  <form class="task-actions" method="POST" action="/api/admin/tasks">
                    <input type="hidden" name="id" value={task.id} />
                    <button type="submit" name="action" value="run" disabled={kvMissing}>
                      Run now
                    </button>
                    <button
                      type="submit"
                      name="action"
                      value={state.paused ? "resume" : "pause"}
                      class="secondary"
                      disabled={kvMissing}
                    >
                      {state.paused ? "Resume" : "Pause"}
                    </button>
                  </form>
                </li>
              ))
            }
          </ul>
        </section>
      </main>

    <script
      type="application/json"
      id="cities-data"
      set:html={JSON.stringify(CITIES)}
    />

    <style>
      body {
        max-width: 58rem;
        padding: 3rem 1.5rem 4rem;
      }

      .dash-head {
        text-align: center;
      }
      .dash-head h1 {
        font-size: 1.15rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      .dash-head .tagline {
        color: var(--muted);
        margin-top: 0.2rem;
      }
      .dash-who {
        margin-top: 0.7rem;
        color: var(--muted);
        font-size: 0.82rem;
      }
      .dash-who a {
        color: var(--muted);
        text-decoration: underline;
        text-decoration-color: var(--rule);
        text-underline-offset: 0.2em;
        transition: text-decoration-color 0.15s ease, color 0.15s ease;
      }
      .dash-who a:hover {
        color: var(--fg);
        text-decoration-color: var(--fg);
      }
      .dash-email {
        color: var(--fg);
        font-variant-numeric: tabular-nums;
      }
      .dash-who .sep {
        margin: 0 0.35rem;
        color: var(--rule);
      }
      .dash-badge {
        display: inline-block;
        padding: 0.18rem 0.6rem;
        border: 1px solid var(--rule);
        border-radius: 2px;
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      /* Section nav — matches the public site's SectionTaskbar exactly. */
      .dash-taskbar {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        margin: 1.7rem 0 2rem;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
      }
      .dash-taskbar .tab {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 2.75rem;
        border-right: 1px solid var(--rule);
        color: var(--muted);
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        line-height: 1;
        text-align: center;
        text-decoration: none;
        text-transform: uppercase;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease;
      }
      .dash-taskbar .tab:last-child {
        border-right: 0;
      }
      .dash-taskbar .tab:hover {
        background: var(--rule);
        color: var(--fg);
      }
      .dash-taskbar .tab.is-active {
        background: var(--fg);
        color: var(--bg);
      }
      .dash-taskbar .tab.is-soon {
        opacity: 0.4;
        cursor: default;
      }
      .dash-taskbar .tab.is-soon:hover {
        background: transparent;
        color: var(--muted);
      }

      .pane-head h2 {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        text-transform: none;
        color: var(--fg);
      }
      .pane-head {
        margin-bottom: 1.5rem;
      }
      .pane-sub {
        margin: 0.2rem 0 0;
        color: var(--muted);
        font-size: 0.9rem;
      }

      /* ---------- Overview ---------- */
      .status-panel {
        border: 1px solid var(--rule);
        border-radius: 3px;
        padding: 0.4rem 1.2rem;
      }
      .status-list {
        margin: 0;
      }
      .status-row {
        position: relative;
        display: grid;
        grid-template-columns: 5rem minmax(0, 1fr) auto;
        align-items: baseline;
        gap: 1rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--rule);
      }
      .status-row:last-child {
        border-bottom: 0;
      }
      .status-row dt {
        margin: 0;
        color: var(--muted);
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .status-row dd {
        margin: 0;
        font-size: 0.95rem;
        color: var(--fg);
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .status-state[data-on="true"] {
        color: var(--fg);
      }
      .status-state[data-on="false"] {
        color: var(--muted);
      }
      .status-text {
        color: var(--muted);
      }
      .status-sep {
        margin: 0 0.2rem;
        color: var(--rule);
      }
      .status-swatch {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.1rem;
        height: 1.5rem;
        border: 1px solid var(--rule);
        border-radius: 2px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.05em;
      }

      .status-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        margin-top: 1.25rem;
      }
      .status-actions a {
        color: var(--muted);
        font-size: 0.88rem;
        text-decoration: none;
      }
      .status-actions a:hover {
        color: var(--fg);
      }

      /* ---------- Tasks ---------- */
      .pane-sub code {
        font-size: 0.85em;
      }
      .task-list {
        list-style: none;
        margin: 0;
        padding: 0;
        border: 1px solid var(--rule);
        border-radius: 3px;
      }
      .task {
        padding: 1rem 1.2rem;
        border-bottom: 1px solid var(--rule);
      }
      .task:last-child {
        border-bottom: 0;
      }
      .task-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.35rem 0.75rem;
      }
      .task-head h3 {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: normal;
        text-align: left;
        text-transform: none;
        color: var(--fg);
      }
      .task-state {
        min-width: 4.5rem;
        color: var(--muted);
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .task-state[data-state="ok"],
      .task-state[data-state="done"] {
        color: #01ed7e;
      }
      .task-state[data-state="failed"] {
        color: #ff6b66;
      }
      .task-state[data-state="running"] {
        color: var(--fg);
      }
      .task-desc,
      .task-meta {
        margin: 0.35rem 0 0;
        font-size: 0.85rem;
        color: var(--muted);
      }
      .task-meta {
        color: var(--fg);
        overflow-wrap: anywhere;
      }
      .task-history {
        margin-top: 0.5rem;
        font-size: 0.8rem;
        color: var(--muted);
      }
      .task-history summary {
        cursor: pointer;
      }
      .task-history ol {
        display: grid;
        gap: 0.25rem;
        margin: 0.4rem 0 0;
        padding: 0;
        list-style: none;
      }
      .task-history li {
        display: flex;
        flex-wrap: wrap;
        gap: 0 0.6rem;
      }
      .task-history li[data-ok="false"] .run-result {
        color: #ff6b66;
      }
      .task-actions {
        display: flex;
        gap: 0.6rem;
        margin-top: 0.75rem;
      }
      .task-actions button[type="submit"] {
        padding: 0.4rem 0.9rem;
        font-size: 0.8rem;
      }
      .task-actions button.secondary {
        background: transparent;
        color: var(--fg);
        border: 1px solid var(--rule);
      }

      /* ---------- Toasts ---------- */
      .dash-toast {
        margin: 0 0 1.25rem;
        padding: 0.6rem 0.85rem;
        border: 1px solid var(--rule);
        border-radius: 2px;
        font-size: 0.85rem;
      }
      .dash-toast.ok {
        border-color: #01ed7e;
        color: #01ed7e;
      }
      .dash-toast.err {
        border-color: #ff6b66;
        color: #ff6b66;
      }

      /* ---------- Form ---------- */
      .form-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
        gap: 1.5rem;
        align-items: start;
      }
      .form-fields {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      fieldset.card {
        border: 1px solid var(--rule);
        border-radius: 3px;
        margin: 0;
        padding: 0.5rem 1.1rem 1.2rem;
      }
      fieldset.card legend {
        padding: 0 0.4rem;
        color: var(--muted);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .site-form label {
        display: block;
        margin-top: 0.95rem;
        font-size: 0.85rem;
      }
      .site-form label .lbl {
        display: block;

      }

      .actions {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-top: 0.25rem;
      }
      button[type="submit"] {
        padding: 0.65rem 1.5rem;
        background: var(--fg);
        color: var(--bg);
        border: 0;
        border-radius: 2px;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      button[type="submit"]:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
      .view {
        color: var(--muted);
        font-size: 0.85rem;
        text-decoration: none;
      }
      .view:hover {
        color: var(--fg);
      }

      /* ---------- Preview ---------- */
      .form-preview {
        position: sticky;
        top: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        padding: 1.15rem 1.2rem 1.4rem;
        border: 1px solid var(--rule);
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.015);
      }
      .form-preview h3 {
        margin: 0;
        color: var(--fg);
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.04em;
      }
      .preview-tag {
        margin-top: 0.35rem;
        color: var(--muted);
        font-size: 0.66rem;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .preview-frame {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--rule);
        border-radius: 2px;
        background: #0a0a09;
      }
      .preview-banner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        width: 100%;
        min-height: 2rem;
        padding: 0.5rem 0.8rem;
        background: var(--banner-bg, #01ed7e);
        color: var(--banner-fg, #000);
        font-size: 0.58rem;
        font-weight: 600;
        letter-spacing: 0.11em;
        line-height: 1.3;
        text-align: center;
        text-transform: uppercase;
      }
      .preview-banner a {
        color: var(--banner-fg, #000);
        text-decoration: underline;
        text-decoration-color: color-mix(
          in srgb,
          var(--banner-fg, #000) 45%,
          transparent
        );
        text-underline-offset: 0.18em;
        white-space: nowrap;
      }
      .preview-banner[data-enabled="false"] {
        display: none;
      }
      .preview-disabled {
        padding: 0.6rem 0.8rem;
        color: var(--muted);
        font-size: 0.72rem;
        text-align: center;
        border-bottom: 1px solid var(--rule);
      }
      .preview-page {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        padding: 1.6rem 0.8rem 1.4rem;
      }
      .preview-hero {
        color: #f3f3ef;
        font-size: 1.1rem;
        font-weight: 500;
        letter-spacing: -0.01em;
      }
      .preview-page-stub {
        width: 70%;
        height: 0.35rem;
        background: var(--rule);
        border-radius: 999px;
      }

      .preview-globe {
        padding: 0.95rem 1.05rem 1.1rem;
        border: 1px solid var(--rule);
        border-radius: 2px;
      }
      .preview-globe dl {
        margin: 0;
        display: grid;
        gap: 0.55rem;
      }
      .preview-globe dt {
        color: var(--muted);
        font-size: 0.66rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }
      .preview-globe dd {
        margin: 0.1rem 0 0;
        color: var(--fg);
        font-size: 0.9rem;
      }
      .preview-eta {
        display: block;
        margin-top: 0.15rem;
        color: var(--muted);
        font-size: 0.78rem;
        font-variant-numeric: tabular-nums;
      }
      .preview-arrow {
        color: var(--muted);
      }
      #previewHomeCoords,
      #previewDestCoords {
        font-variant-numeric: tabular-nums;
        font-size: 0.8rem;
      }

      /* ---------- Mobile ---------- */
      @media (max-width: 760px) {
        .form-grid {
          grid-template-columns: 1fr;
        }
        .form-preview {
          position: static;
        }
        .itinerary {
          grid-template-columns: 1fr;
        }
        .itinerary-arrow {
          margin-top: 0;
          justify-self: center;
          transform: rotate(90deg);
        }
      }
      @media (max-width: 420px) {
        .dash-taskbar {
          grid-template-columns: repeat(2, 1fr);
        }
        .dash-taskbar .tab:nth-child(2) {
          border-right: 0;
        }
        .dash-taskbar .tab:nth-child(-n + 2) {
          border-bottom: 1px solid var(--rule);
        }
      }
    </style>

    <script>
      // ---------- Tab switching ----------
      const tabs = document.querySelectorAll<HTMLElement>(".dash-taskbar .tab[data-tab]");
      const panes = document.querySelectorAll<HTMLElement>(".dash-pane[data-pane]");
      function showTab(key: string) {
        tabs.forEach((t) =>
          t.classList.toggle("is-active", t.dataset.tab === key),
        );
        panes.forEach((p) => (p.hidden = p.dataset.pane !== key));
      }
      tabs.forEach((t) => {
        t.addEventListener("click", (e) => {
          e.preventDefault();
          const key = t.dataset.tab!;
          history.replaceState(null, "", "#" + key);
          showTab(key);
        });
      });
      const initial = (location.hash || "#overview").slice(1);
      if ([...tabs].some((t) => t.dataset.tab === initial)) showTab(initial);
      window.addEventListener("hashchange", () => {
        const key = location.hash.slice(1);
        if ([...tabs].some((t) => t.dataset.tab === key)) showTab(key);
      });

      // ---------- Tasks: show progress while a run is in flight ----------
      document.querySelectorAll<HTMLFormElement>(".task-actions").forEach((form) => {
        form.addEventListener("submit", (e) => {
          const btn = (e as SubmitEvent).submitter as HTMLButtonElement | null;
          if (btn?.value === "run") btn.textContent = "Running…";
          // Defer so the submitter's name/value still makes it into the POST.
          setTimeout(() => form.querySelectorAll("button").forEach((b) => (b.disabled = true)));
        });
      });

      // ---------- Banner: text + link live preview ----------
      const $ = <T extends HTMLElement>(id: string) =>
        document.getElementById(id) as T | null;
      const bind = (
        inputId: string,
        bindKey: string,
        attr: "text" | "href" = "text",
      ) => {
        const input = $<HTMLInputElement>(inputId);
        const target = document.querySelector<HTMLElement>(
          `[data-bind="${bindKey}"]`,
        );
        if (!input || !target) return;
        input.addEventListener("input", () => {
          if (attr === "text") target.textContent = input.value;
          else target.setAttribute("href", input.value);
        });
      };
      bind("bannerPrefix", "bannerPrefix");
      bind("bannerText", "bannerText");
      bind("bannerLinkLabel", "bannerLink");
      bind("bannerLinkHref", "bannerLink", "href");

      // ---------- Banner: enable toggle ----------
      const bannerEnabled = $<HTMLInputElement>("bannerEnabled");
      const previewBanner = $<HTMLElement>("previewBanner");
      const previewDisabled =
        document.querySelector<HTMLElement>(".preview-disabled");
      bannerEnabled?.addEventListener("change", () => {
        const on = bannerEnabled.checked;
        previewBanner?.setAttribute("data-enabled", String(on));
        if (previewDisabled) previewDisabled.hidden = on;
      });

      // ---------- Banner: color picker ↔ hex sync ----------
      function syncColor(pickerId: string, hexId: string, cssVar: string) {
        const picker = $<HTMLInputElement>(pickerId);
        const hex = $<HTMLInputElement>(hexId);
        if (!picker || !hex || !previewBanner) return;
        const apply = (val: string) => {
          previewBanner.style.setProperty(cssVar, val);
        };
        picker.addEventListener("input", () => {
          hex.value = picker.value;
          apply(picker.value);
        });
        hex.addEventListener("input", () => {
          const v = hex.value.trim();
          if (/^#[0-9a-fA-F]{6}$/.test(v)) {
            picker.value = v;
            apply(v);
          }
        });
      }
      syncColor("bannerBg", "bannerBgHex", "--banner-bg");
      syncColor("bannerFg", "bannerFgHex", "--banner-fg");

      // ---------- Banner palette chips ----------
      document.querySelectorAll<HTMLButtonElement>(".swatch").forEach((sw) => {
        sw.addEventListener("click", () => {
          const bg = sw.dataset.bg!;
          const fg = sw.dataset.fg!;
          const bgP = $<HTMLInputElement>("bannerBg")!;
          const fgP = $<HTMLInputElement>("bannerFg")!;
          const bgH = $<HTMLInputElement>("bannerBgHex")!;
          const fgH = $<HTMLInputElement>("bannerFgHex")!;
          bgP.value = bg;
          bgH.value = bg;
          fgP.value = fg;
          fgH.value = fg;
          previewBanner?.style.setProperty("--banner-bg", bg);
          previewBanner?.style.setProperty("--banner-fg", fg);
        });
      });

      // ---------- Itinerary combobox (geocoder) ----------
      // Free-text "From → To" inputs with autocomplete. Local CITIES list gives
      // instant matches; Nominatim (OpenStreetMap) fills in any address; once a
      // home city is picked we look up its IANA timezone via timeapi.io so the
      // globe's clock stays in sync. No API keys required.
      type City = {
        key: string;
        label: string;
        lat: number;
        lon: number;
        timezone: string;
      };
      const citiesEl = document.getElementById("cities-data");
      const cities: City[] = citiesEl
        ? JSON.parse(citiesEl.textContent || "[]")
        : [];

      const fmtLat = (lat: number) =>
        `${Math.abs(lat).toFixed(4)}° ${lat >= 0 ? "N" : "S"}`;
      const fmtLon = (lon: number) =>
        `${Math.abs(lon).toFixed(4)}° ${lon >= 0 ? "E" : "W"}`;
      const esc = (s: string) =>
        s
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");

      type Suggestion = {
        label: string;
        display: string;
        lat: number;
        lon: number;
        tz?: string;
        source: "preset" | "search";
      };

      function presetMatches(q: string, limit = 3): Suggestion[] {
        const Q = q.toLowerCase();
        return cities
          .filter((c) => c.label.toLowerCase().includes(Q))
          .slice(0, limit)
          .map((c) => ({
            label: c.label,
            display: c.label,
            lat: c.lat,
            lon: c.lon,
            tz: c.timezone,
            source: "preset" as const,
          }));
      }

      async function nominatim(
        q: string,
        signal: AbortSignal,
      ): Promise<Suggestion[]> {
        const url = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(q)}&format=json&limit=6`;
        const res = await fetch(url, {
          headers: { Accept: "application/json" },
          signal,
        });
        if (!res.ok) return [];
        const data: any[] = await res.json();
        return data.map((r) => {
          const display: string = r.display_name;
          // "City, Country" — first and last segments of the display name
          // (the middle is district/state noise like "Taipei, Datong
          // District, Taipei, Taiwan").
          const parts = display.split(",").map((p: string) => p.trim());
          return {
            label:
              parts.length > 1
                ? `${parts[0]}, ${parts[parts.length - 1]}`
                : parts[0],
            display,
            lat: parseFloat(r.lat),
            lon: parseFloat(r.lon),
            source: "search" as const,
          };
        });
      }

      async function lookupTz(lat: number, lon: number): Promise<string | null> {
        try {
          const res = await fetch(
            `https://timeapi.io/api/TimeZone/coordinate?latitude=${lat}&longitude=${lon}`,
          );
          if (!res.ok) return null;
          const data: any = await res.json();
          return typeof data.timeZone === "string" ? data.timeZone : null;
        } catch {
          return null;
        }
      }

      function setupCombo(scope: "home" | "dest", withTz: boolean) {
        const root = document.querySelector<HTMLElement>(
          `.combo[data-scope="${scope}"]`,
        );
        if (!root) return;
        const input = root.querySelector<HTMLInputElement>(
          "input[type='text']",
        )!;
        const list = root.querySelector<HTMLElement>(".combo-list")!;
        const latEl = $<HTMLInputElement>(scope + "Lat")!;
        const lonEl = $<HTMLInputElement>(scope + "Lon")!;
        const tzEl = withTz ? $<HTMLInputElement>(scope + "Tz") : null;
        const coordsMeta = root.querySelector<HTMLElement>(
          '[data-meta="coords"]',
        )!;
        const tzMeta = root.querySelector<HTMLElement>('[data-meta="tz"]');

        let debounce = 0;
        let ctl: AbortController | null = null;
        // Track the label that matches the currently-selected coords. If the
        // user edits past this without picking a new suggestion, the combobox
        // shows an "is-stale" dot — coords no longer reflect the typed label.
        let lockedLabel = input.value.trim();

        // If the stored coordinates match a preset city but the stored label
        // doesn't, this row was saved as a typed label over stale coordinates
        // (possible before the save-time resolver below existed). Treat it as
        // stale so the next save re-resolves the label to real coordinates.
        {
          const lat = parseFloat(latEl.value);
          const lon = parseFloat(lonEl.value);
          const near = cities.find(
            (c) => Math.abs(c.lat - lat) < 0.01 && Math.abs(c.lon - lon) < 0.01,
          );
          if (near && near.label.toLowerCase() !== lockedLabel.toLowerCase()) {
            lockedLabel = "";
            setState("stale");
          }
        }

        function setState(state: "" | "stale" | "fresh" | "loading") {
          root.classList.remove("is-stale", "is-fresh", "is-loading");
          if (state) root.classList.add("is-" + state);
        }

        function render(items: Suggestion[], status: "" | "empty" | "error" = "") {
          if (status === "empty") {
            list.innerHTML = `<div class="combo-item is-empty">No matches</div>`;
          } else if (status === "error") {
            list.innerHTML = `<div class="combo-item is-empty">Search failed — try again.</div>`;
          } else {
            list.innerHTML = items
              .map(
                (s, i) => `
                  <button type="button" class="combo-item" data-i="${i}">
                    <div class="combo-item-row">
                      <span class="combo-item-label">${esc(s.display)}</span>
                      <span class="combo-item-tag">${s.source}</span>
                    </div>
                    <span class="combo-item-coords">${fmtLat(s.lat)} · ${fmtLon(s.lon)}</span>
                  </button>`,
              )
              .join("");
            list
              .querySelectorAll<HTMLButtonElement>(".combo-item[data-i]")
              .forEach((el) => {
                // mousedown prevents the input from losing focus & hiding the list
                // before the click registers.
                el.addEventListener("mousedown", (e) => e.preventDefault());
                el.addEventListener("click", () => {
                  const i = parseInt(el.dataset.i!, 10);
                  pick(items[i]);
                });
              });
          }
          list.hidden = false;
        }

        async function pick(s: Suggestion) {
          input.value = s.label;
          latEl.value = String(s.lat);
          lonEl.value = String(s.lon);
          coordsMeta.textContent = `${fmtLat(s.lat)} · ${fmtLon(s.lon)}`;
          if (tzEl && tzMeta) {
            if (s.tz) {
              tzEl.value = s.tz;
              tzMeta.textContent = s.tz;
            } else {
              tzMeta.textContent = "looking up…";
              const tz = await lookupTz(s.lat, s.lon);
              if (tz) {
                tzEl.value = tz;
                tzMeta.textContent = tz;
              } else {
                tzMeta.textContent = tzEl.value || "—";
              }
            }
          }
          list.hidden = true;
          lockedLabel = input.value.trim();
          setState("fresh");
          updateAfterPick();
        }

        input.addEventListener("input", () => {
          const q = input.value.trim();
          updateAfterPick(); // keep summary/preview labels in sync as user types
          window.clearTimeout(debounce);
          if (q.length < 2) {
            list.hidden = true;
            setState(q === lockedLabel ? "" : "stale");
            return;
          }
          setState("loading");
          debounce = window.setTimeout(async () => {
            ctl?.abort();
            ctl = new AbortController();
            const presets = presetMatches(q);
            try {
              const remote = await nominatim(q, ctl.signal);
              const deduped = remote.filter(
                (r) =>
                  !presets.some(
                    (p) =>
                      Math.abs(p.lat - r.lat) < 0.1 &&
                      Math.abs(p.lon - r.lon) < 0.1,
                  ),
              );
              const merged = [...presets, ...deduped].slice(0, 8);
              if (!merged.length) render([], "empty");
              else render(merged);
            } catch (e: any) {
              if (e?.name === "AbortError") return;
              if (presets.length) render(presets);
              else render([], "error");
            } finally {
              setState(input.value.trim() === lockedLabel ? "" : "stale");
            }
          }, 280);
        });

        input.addEventListener("blur", () => {
          window.setTimeout(() => (list.hidden = true), 150);
        });
        input.addEventListener("keydown", (e) => {
          if (e.key === "Escape") list.hidden = true;
        });

        // Save-time safety net: if the label was typed (or edited) without
        // picking a suggestion, the hidden lat/lon/tz fields still hold the
        // previous place. Resolve the typed text to real coordinates — presets
        // first, then Nominatim — so a save can never pair a new label with
        // stale coordinates.
        async function resolve(): Promise<boolean> {
          const q = input.value.trim();
          if (q === lockedLabel) return true;
          if (!q) return false;
          setState("loading");
          const presets = presetMatches(q);
          let s: Suggestion | null =
            presets.find((p) => p.label.toLowerCase() === q.toLowerCase()) ??
            presets[0] ??
            null;
          if (!s) {
            try {
              ctl?.abort();
              ctl = new AbortController();
              s = (await nominatim(q, ctl.signal))[0] ?? null;
            } catch {
              s = null;
            }
          }
          if (!s) {
            setState("stale");
            render([], "empty");
            input.focus();
            return false;
          }
          // Keep the label exactly as typed — resolution fixes the
          // coordinates/timezone, it shouldn't rewrite the user's preferred
          // name for the place ("Taipei, Taiwan" → "Taipei"). Presets keep
          // their canonical label so a fragment like "hangz" still saves as
          // "Hangzhou, China".
          await pick(s.source === "preset" ? s : { ...s, label: q });
          return true;
        }

        return {
          isStale: () => input.value.trim() !== lockedLabel,
          resolve,
        };
      }

      const combos = [setupCombo("home", true), setupCombo("dest", true)];

      // Resolve any stale combobox before the form posts, then submit for real.
      const siteForm = document.querySelector<HTMLFormElement>(".site-form");
      let resolvingCombos = false;
      siteForm?.addEventListener("submit", (e) => {
        const stale = combos.filter((c) => c && c.isStale());
        if (!stale.length) return;
        e.preventDefault();
        if (resolvingCombos) return;
        resolvingCombos = true;
        Promise.all(stale.map((c) => c!.resolve()))
          .then((ok) => {
            if (ok.every(Boolean)) siteForm.submit();
          })
          .finally(() => {
            resolvingCombos = false;
          });
      });

      // ---------- Preview / summary updates ----------
      function updateAfterPick() {
        updatePreviewLabels();
        updateSummary();
        updateCoordsPreview();
      }

      function currentLatLon(scope: "home" | "dest") {
        const latEl = $<HTMLInputElement>(scope + "Lat");
        const lonEl = $<HTMLInputElement>(scope + "Lon");
        return {
          lat: parseFloat(latEl?.value || "0"),
          lon: parseFloat(lonEl?.value || "0"),
        };
      }
      function updateCoordsPreview() {
        const h = currentLatLon("home");
        const d = currentLatLon("dest");
        const homeEl = $<HTMLElement>("previewHomeCoords");
        const destEl = $<HTMLElement>("previewDestCoords");
        if (homeEl) homeEl.textContent = `${fmtLat(h.lat)} · ${fmtLon(h.lon)}`;
        if (destEl) destEl.textContent = `${fmtLat(d.lat)} · ${fmtLon(d.lon)}`;
      }
      function updatePreviewLabels() {
        const homeLabel = $<HTMLInputElement>("homeLabel")?.value || "";
        const destLabel = $<HTMLInputElement>("destLabel")?.value || "";
        document
          .querySelectorAll<HTMLElement>('[data-bind="homeLabel"]')
          .forEach((el) => (el.textContent = homeLabel));
        document
          .querySelectorAll<HTMLElement>('[data-bind="destLabel"]')
          .forEach((el) => (el.textContent = destLabel));
      }
      function updateSummary() {
        const homeLabel = $<HTMLInputElement>("homeLabel")?.value || "";
        const destLabel = $<HTMLInputElement>("destLabel")?.value || "";
        const arrivalVal = $<HTMLInputElement>("arrival")?.value || "";
        const flight = $<HTMLInputElement>("flight")?.value.trim() || "";
        const sFrom = $<HTMLElement>("summaryFrom");
        const sTo = $<HTMLElement>("summaryTo");
        const sDate = $<HTMLElement>("summaryDate");
        const sFlight = $<HTMLElement>("summaryFlight");
        if (sFrom) sFrom.textContent = homeLabel;
        if (sTo) sTo.textContent = destLabel;
        if (sDate && arrivalVal) {
          const d = new Date(arrivalVal + "T00:00:00");
          sDate.textContent = d.toLocaleDateString("en-US", {
            weekday: "short",
            month: "short",
            day: "numeric",
            year: "numeric",
          });
        }
        if (sFlight) {
          sFlight.hidden = !flight;
          const flightSpan = sFlight.querySelector<HTMLElement>(
            '[data-bind="flight"]',
          );
          if (flightSpan) flightSpan.textContent = flight;
        }
        // Globe-panel preview row for the flight
        const flightRow = $<HTMLElement>("previewFlightRow");
        const flightPreview = document.querySelector<HTMLElement>(
          '[data-bind="flightPreview"]',
        );
        if (flightRow) flightRow.hidden = !flight;
        if (flightPreview) flightPreview.textContent = flight;
      }

      $<HTMLInputElement>("arrival")?.addEventListener("input", updateSummary);
      $<HTMLInputElement>("flight")?.addEventListener("input", updateSummary);

      // ---------- Live countdown ----------
      const countdownEl = $<HTMLElement>("previewCountdown");
      const arrivalEl = $<HTMLInputElement>("arrival");
      function pad(n: number) {
        return String(n).padStart(2, "0");
      }
      function tickCountdown() {
        if (!countdownEl || !arrivalEl?.value) return;
        const target = new Date(arrivalEl.value + "T00:00:00").getTime();
        let s = Math.max(0, Math.floor((target - Date.now()) / 1000));
        const dd = Math.floor(s / 86400);
        s -= dd * 86400;
        const hh = Math.floor(s / 3600);
        s -= hh * 3600;
        const mm = Math.floor(s / 60);
        s -= mm * 60;
        countdownEl.textContent = `${pad(dd)}:${pad(hh)}:${pad(mm)}:${pad(s)}`;
      }
      arrivalEl?.addEventListener("input", tickCountdown);
      tickCountdown();
      setInterval(tickCountdown, 1000);
    </script>
  </body>
</html>

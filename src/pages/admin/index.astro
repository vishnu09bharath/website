        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .color-presets {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.8rem;
      }
      .swatch {
        width: 2.35rem;
        height: 1.75rem;
        padding: 0;
        border: 1px solid var(--rule);
        border-radius: 2px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        cursor: pointer;
        transition: transform 0.12s ease, border-color 0.12s ease;
      }
      .swatch:hover {

---
import Base from "../layouts/Base.astro";
import SectionTaskbar from "../components/SectionTaskbar.astro";

const description =
  "Vishnu Bharath — robotics researcher at the MIT Media Lab's City Science group and founding captain of FRC Team 9644.";
---

<Base title="Vishnu Bharath" description={description}>
  <section class="hero-wrap has-announcement">
    <aside class="announcement" aria-label="Announcement">
      <span>Bharath named 20 Under 20 New England.</span>
      <a
        href="https://indianewengland.com/india-new-england-news-announces-20-under-20-stars-list-for-2026/#vishnubharath"
        >Read more →</a
      >
    </aside>

    <img
      class="hero"
      src="/images/hero-pit.jpg"
      alt="Vishnu standing at the driver station during a FIRST Robotics Competition match"
      width="2400"
      height="1600"
      fetchpriority="high"
    />
    <header class="hero-header">
      <h1>Vishnu Bharath</h1>
    </header>
    <ul class="hero-links">
      <li>
        <a href="https://www.linkedin.com/in/vishnu-bharath-383a24285/"
          >linkedin</a
        >
      </li>
      <li><a href="mailto:mr.vishnubharath@gmail.com">email</a></li>
      <li><a href="https://github.com/vishnu09bharath">github</a></li>
    </ul>
    <a class="scroll-cue" href="#sections" aria-label="Scroll to content">
      <span>↓</span>
    </a>
  </section>

  <main id="sections">
    <p class="intro">
      I'm a sophomore in high school, student researcher, robotics captain,
      builder, and traveler. I work in the City Science group at the MIT Media
      Lab on control and human-robot interaction for last-meter delivery
      robots, and I founded and captain FIRST Robotics Competition Team 9644,
      the 2026 New England Champions.
    </p>

    <SectionTaskbar />
  </main>
</Base>

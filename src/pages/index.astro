---
import Base from "../layouts/Base.astro";

const description =
  "Vishnu Bharath — robotics researcher at the MIT Media Lab's City Science group and founding captain of FRC Team 9644.";

const sections = [
  {
    href: "/media-lab/",
    title: "MIT Media Lab — City Science",
    time: "2024 –",
    blurb: "RL control and human-robot interaction for last-meter delivery robots.",
  },
  {
    href: "/frc/",
    title: "FRC Team 9644",
    time: "2023 –",
    blurb: "Co-founder, captain & driver. 2026 New England Champions.",
  },
  {
    href: "/publications/",
    title: "Publications",
    time: "2026",
    blurb: "Do Robots Need Body Language? — ACM/IEEE HRI ’26.",
  },
  {
    href: "/day-of-ai/",
    title: "MIT Day of AI — Gear Grease",
    time: "2024",
    blurb: "LLM-driven game NPCs, presented at the Boston Museum of Science.",
  },
  {
    href: "/school-store/",
    title: "NEIA School Store",
    time: "2023 – 2025",
    blurb: "CEO. Zero to $25K+ annual revenue at full profitability.",
  },
];
---

<Base title="Vishnu Bharath" description={description}>
  <section class="hero-wrap">
    <img
      class="hero"
      src="/images/hero-pit.jpg"
      alt="Vishnu standing at the driver station during a FIRST Robotics Competition match"
      width="2400"
      height="1600"
      fetchpriority="high"
    />
    <header class="hero-header">
      <h1>Vishnu Bharath</h1>
    </header>
    <ul class="hero-links">
      <li>
        <a href="https://www.linkedin.com/in/vishnu-bharath-383a24285/"
          >linkedin</a
        >
      </li>
      <li><a href="mailto:mr.vishnubharath@gmail.com">email</a></li>
      <li><a href="https://github.com/vishnu09bharath">github</a></li>
    </ul>
    <a class="scroll-cue" href="#work" aria-label="Scroll to content">
      <span>↓</span>
    </a>
  </section>

  <main>
    <p class="intro">
      I'm a student researcher in the City Science group at the MIT Media
      Lab, where I work on control and human-robot interaction for last-meter
      delivery robots in cities. I also founded and captain FIRST Robotics
      Competition Team 9644, the 2026 New England Champions.
    </p>

    <h2 id="work">Work</h2>

    <nav class="cards">
      {
        sections.map((s) => (
          <a class="card" href={s.href}>
            <div class="entry-head">
              <h3>{s.title}</h3>
              <time>{s.time}</time>
            </div>
            <p>{s.blurb}</p>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ))
      }
    </nav>

    <h2>Contact</h2>

    <ul class="contact-list">
      <li>
        <a href="mailto:mr.vishnubharath@gmail.com"
          >mr.vishnubharath@gmail.com</a
        >
      </li>
    </ul>
  </main>
</Base>

---
export const prerender = false;

import "../styles/global.css";
import { getAdmin } from "../lib/auth";

const env = (Astro.locals as any).runtime?.env;
const login = await getAdmin(Astro.cookies, env);

// Already signed in (production) → go straight to the dashboard. In dev the
// bypass makes `login` truthy, so we DON'T redirect — this page stays viewable.
if (login && !import.meta.env.DEV) return Astro.redirect("/admin");

// Approximate visitor location from Cloudflare's edge geo (request.cf), used to
// drop a pulsing marker on the globe. Falls back to Boston in local dev so the
// marker is still demonstrable.
const cf = (Astro.locals as any).runtime?.cf;
const ipLat = cf?.latitude ? Number(cf.latitude) : import.meta.env.DEV ? 42.36 : null;
const ipLon = cf?.longitude ? Number(cf.longitude) : import.meta.env.DEV ? -71.06 : null;
const hasIpLoc = Number.isFinite(ipLat) && Number.isFinite(ipLon);

// A short label for the location annotation that types out before zooming out:
// city/region when the edge provides it, otherwise the coordinates.
const fmtLat = (v: number) => `${Math.abs(v).toFixed(2)}°${v >= 0 ? "N" : "S"}`;
const fmtLon = (v: number) => `${Math.abs(v).toFixed(2)}°${v >= 0 ? "E" : "W"}`;
const placeParts = [cf?.city, cf?.region || cf?.country].filter(Boolean);
const ipLabel = !hasIpLoc
  ? ""
  : placeParts.length
    ? placeParts.join(", ")
    : `${fmtLat(ipLat as number)} ${fmtLon(ipLon as number)}`;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Log in — Vishnu Bharath</title>
  </head>
  <body class="login-body">
    <canvas
      class="globe-bg"
      aria-hidden="true"
      data-ip-lat={hasIpLoc ? String(ipLat) : undefined}
      data-ip-lon={hasIpLoc ? String(ipLon) : undefined}
    ></canvas>
    <div class="shade" aria-hidden="true"></div>

    {
      hasIpLoc && ipLabel && (
        <div class="ip-annot" data-label={ipLabel} aria-hidden="true" />
      )
    }

    <main class="panel">
      <h1>
        <span class="welcome">Welcome back,</span>
        Vishnu.
      </h1>

      <div class="auth">
        <a class="google-btn" href="/api/auth/start">
          <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
            <path d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          </svg>
          <span>Log in with Google</span>
        </a>

        <form class="codeword-form" action="/login-failed" method="get" hidden>
          <input type="hidden" name="reason" value="codeword" />
          <input
            class="codeword-input"
            type="password"
            name="codeword"
            placeholder="Security Key"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            aria-label="Security Key"
          />
          <button type="submit" class="codeword-submit" aria-label="Submit"
            >↵</button
          >
        </form>

        <p class="revert-line" hidden>
          Revert to <button type="button" class="revert-trigger"
            >standard authentication</button
          >.
        </p>

        <p class="op-line">
          or <button type="button" class="op-trigger"
            >initiate Operation Nørthwood</button
          >.
        </p>
      </div>

      <p class="note"><a href="/">← Back home</a>.</p>
    </main>

    <footer class="login-footer">
      <span class="footer-copy">© {year} Vishnu Bharath</span>
      <span class="dot" aria-hidden="true">·</span>
      <a class="footer-privacy" href="/privacy/">Privacy</a>
    </footer>

    <div class="clock" aria-hidden="true">--:--:--</div>

    <style>
      /* Full-bleed: override global.css's centered/padded body. */
      body.login-body {
        max-width: none;
        margin: 0;
        padding: 0;
        min-height: 100svh;
        position: relative;
        overflow: hidden;
      }
      .globe-bg {
        position: fixed;
        inset: 0;
        z-index: 0;
        width: 100%;
        height: 100%;
        display: block;
      }
      /* Soften (blur) the globe behind the panel on the left so the text reads,
         fading back to a crisp globe on the right. */
      .shade {
        position: fixed;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        -webkit-mask-image: linear-gradient(
          to right,
          #000 0%,
          #000 34%,
          transparent 60%
        );
        mask-image: linear-gradient(
          to right,
          #000 0%,
          #000 34%,
          transparent 60%
        );
      }
      .panel {
        position: relative;
        z-index: 2;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 2rem;
        max-width: 30rem;
        padding: 2rem clamp(1.5rem, 6vw, 5rem);
      }
      .panel h1 {
        font-size: clamp(1.8rem, 4.2vw, 2.5rem);
        font-weight: 500;
        line-height: 1.15;
        letter-spacing: -0.015em;
        color: var(--fg);
      }
      .welcome {
        display: block;
        color: var(--muted);
      }
      .google-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        align-self: flex-start;
        /* Match the security-key input's height so the swap doesn't shift layout. */
        box-sizing: border-box;
        height: 42px;
        background: color-mix(in srgb, var(--fg) 7%, transparent);
        color: var(--fg);
        border: 1px solid var(--rule);
        border-radius: 3px;
        padding: 0 1.2rem;
        font-size: 0.92rem;
        font-weight: 500;
        text-decoration: none;
        transition:
          border-color 0.15s ease,
          background-color 0.15s ease;
      }
      .google-btn:hover {
        border-color: var(--fg);
        background: color-mix(in srgb, var(--fg) 12%, transparent);
      }
      /* Monochrome the Google mark to match the grayscale button. */
      .google-btn svg path {
        fill: currentColor;
      }
      .auth {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.7rem;
      }
      /* [hidden] must beat the element rules' explicit `display` values. */
      .auth [hidden] {
        display: none !important;
      }
      .codeword-form {
        position: relative;
      }
      .codeword-input {
        align-self: flex-start;
        box-sizing: border-box;
        height: 42px;
        width: min(22rem, 70vw);
        background: color-mix(in srgb, var(--fg) 7%, transparent);
        color: var(--fg);
        border: 1px solid var(--rule);
        border-radius: 3px;
        padding: 0.65rem 2.2rem 0.65rem 0.6rem;
        font-size: 0.92rem;
        font-weight: 500;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        letter-spacing: 0.04em;
        outline: none;
        transition:
          border-color 0.15s ease,
          background-color 0.15s ease;
      }
      .codeword-input::placeholder {
        color: var(--muted);
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        letter-spacing: normal;
      }
      .codeword-input:focus {
        border-color: var(--fg);
        background: color-mix(in srgb, var(--fg) 12%, transparent);
      }
      /* Submit affordance that appears at the end of the box once enough of
         the key is typed. */
      .codeword-submit {
        position: absolute;
        right: 0.5rem;
        top: 50%;
        transform: translateY(calc(-50% + 2px));
        display: flex;
        align-items: center;
        justify-content: center;
        background: none;
        border: none;
        padding: 0 0.2rem;
        cursor: pointer;
        color: var(--muted);
        font-size: 1.05rem;
        line-height: 1;
        opacity: 0;
        pointer-events: none;
        transition:
          opacity 0.2s ease,
          color 0.15s ease;
      }
      .codeword-submit.is-visible {
        opacity: 1;
        pointer-events: auto;
      }
      .codeword-submit:hover {
        color: var(--fg);
      }
      .op-line,
      .revert-line {
        align-self: flex-start;
        margin: 0;
        color: var(--muted);
        font-size: 0.8rem;
        letter-spacing: 0.01em;
      }
      /* Underlined, link-styled buttons for the operation toggle + revert. */
      .op-trigger,
      .revert-trigger {
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        cursor: pointer;
        color: var(--muted);
        font-size: 0.8rem;
        letter-spacing: 0.01em;
        font-family: inherit;
        text-decoration: underline;
        text-underline-offset: 2px;
        transition: color 0.15s ease;
      }
      .op-trigger:hover,
      .revert-trigger:hover {
        color: var(--fg);
      }
      .note {
        margin: 0;
        color: var(--muted);
        font-size: 0.85rem;
      }
      .note a {
        color: var(--muted);
        text-decoration: underline;
        text-underline-offset: 2px;
        white-space: nowrap;
      }
      .note a:hover {
        color: var(--fg);
      }
      .login-footer {
        position: fixed;
        left: clamp(1.5rem, 6vw, 5rem);
        bottom: 1rem;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        border-top: none;
        color: var(--muted);
        font-size: 0.8rem;
      }
      .login-footer .footer-privacy {
        color: var(--muted);
        text-decoration: underline;
        text-underline-offset: 2px;
        white-space: nowrap;
      }
      .login-footer .footer-privacy:hover {
        color: var(--fg);
      }
      .login-footer .dot {
        opacity: 0.6;
      }
      .clock {
        position: fixed;
        right: 1.25rem;
        bottom: 1rem;
        z-index: 2;
        color: rgba(47, 129, 247, 0.85);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.85rem;
        letter-spacing: 0.06em;
      }
      /* Location annotation that types out beside the IP marker (which sits at
         the globe center cx=66% / cy=36% while zoomed in), then fades out. */
      .ip-annot {
        position: fixed;
        left: 0;
        top: 0;
        z-index: 2;
        /* left/top are set per-frame in JS to the dot's screen position; this
           offset places the label just to the right of the dot. */
        transform: translate(16px, -50%);
        will-change: left, top;
        max-width: 40vw;
        color: rgba(47, 129, 247, 0.92);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.6s ease;
      }
      .ip-annot.show {
        opacity: 1;
      }
      .ip-annot.typing::after {
        content: "▌";
        animation: annot-caret 0.9s step-end infinite;
      }
      @keyframes annot-caret {
        50% {
          opacity: 0;
        }
      }
    </style>

    <script>
      // "Operation Northwood": swap the Google button for a security-key input,
      // with a link to revert to the standard Google sign-in.
      const opTrigger = document.querySelector(".op-trigger");
      const opLine = document.querySelector(".op-line");
      const revertTrigger = document.querySelector(".revert-trigger");
      const revertLine = document.querySelector(".revert-line");
      const authError = document.querySelector(".auth-error");
      const googleBtn = document.querySelector(".google-btn");
      const codewordForm = document.querySelector(".codeword-form");
      const codewordInput = document.querySelector(".codeword-input");
      function setOpMode(on) {
        if (googleBtn) googleBtn.hidden = on;
        if (codewordForm) codewordForm.hidden = !on;
        if (revertLine) revertLine.hidden = !on;
        if (opLine) opLine.hidden = on;
        if (authError) authError.hidden = !on;
        if (on && codewordInput) codewordInput.focus();
      }
      if (opTrigger) opTrigger.addEventListener("click", () => setOpMode(true));
      if (revertTrigger)
        revertTrigger.addEventListener("click", () => setOpMode(false));

      // Reveal the submit arrow once the key reaches three characters.
      const codewordSubmit = document.querySelector(".codeword-submit");
      if (codewordInput && codewordSubmit) {
        codewordInput.addEventListener("input", () => {
          codewordSubmit.classList.toggle(
            "is-visible",
            codewordInput.value.length >= 3,
          );
        });
      }
    </script>

    <script>
      // Rotating blue wireframe globe (orthographic): country outlines +
      // graticule with a few pulsing coastal markers. Blue matches the about
      // page globe's point-of-interest blue (47,129,247).
      const BLUE = "47,129,247";
      const DEG = Math.PI / 180;
      const PHI_REST = 35 * DEG; // resting tilt (higher → more of the north pole)
      let phi = PHI_REST; // animated during the intro fly-out
      let sinP = Math.sin(phi);
      let cosP = Math.cos(phi);
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      const canvas = document.querySelector(".globe-bg");
      const clockEl = document.querySelector(".clock");
      const ctx = canvas && canvas.getContext("2d");

      if (clockEl) {
        const fmt = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/New_York",
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit",
          hour12: false,
          timeZoneName: "short",
        });
        const tick = () => (clockEl.textContent = fmt.format(new Date()));
        tick();
        setInterval(tick, 1000);
      }

      if (canvas && ctx) {
        // Two outline layers, drawn back-to-front: country borders sit behind
        // (faint), continent outlines sit on top (prominent) — so coastlines
        // read clean and internal country borders show as a quiet underlayer.
        let countryRings = [];
        let continentRings = [];
        let W = 0, H = 0, cx = 0, cy = 0, R = 1, Rrest = 1, Rzoom = 1, dpr = 1;
        let last = performance.now();

        // Approximate visitor location (from Cloudflare edge geo via data-*).
        const ipLat = parseFloat(canvas.dataset.ipLat);
        const ipLon = parseFloat(canvas.dataset.ipLon);
        const hasIp = Number.isFinite(ipLat) && Number.isFinite(ipLon);

        // Resting longitude: settle with the visitor's location framed a touch
        // east of centre (the framing the home location had), then rotate on from
        // there — instead of always panning to a fixed view of the Americas.
        const REST_OFFSET = 23.5;
        const LAM_REST = hasIp ? ipLon - REST_OFFSET : -95;
        let lam = LAM_REST;

        // Intro fly-out: open zoomed in + centered on the visitor's location,
        // then ease out (zoom, rotate, tilt) to the resting orientation. Skipped
        // without a location or when the user prefers reduced motion.
        const INTRO_MS = 2800;
        const introOn = hasIp && !reduce;
        const lamFrom = ipLon; // centering longitude on the visitor
        const phiFrom = Math.max(-83, Math.min(83, ipLat)) * DEG;
        // Hold zoomed in while a location label types out, then ~1s extra,
        // before the zoom-out begins.
        const annotEl = document.querySelector(".ip-annot");
        const annotLabel = (annotEl && annotEl.dataset.label) || "";
        const TYPE_MS = 42;
        const HOLD_MS = introOn ? annotLabel.length * TYPE_MS + 1000 : 0;
        let introStart = null;
        const easeInOut = (t) =>
          t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        const shortDelta = (a, b) => ((b - a + 540) % 360) - 180;

        // Type the label out, then fade it as the zoom-out starts.
        if (introOn && annotEl && annotLabel) {
          annotEl.classList.add("show", "typing");
          let ci = 0;
          const typer = setInterval(() => {
            annotEl.textContent = annotLabel.slice(0, ++ci);
            if (ci >= annotLabel.length) clearInterval(typer);
          }, TYPE_MS);
          setTimeout(() => {
            clearInterval(typer);
            annotEl.textContent = annotLabel;
            annotEl.classList.remove("typing", "show"); // caret off + fade out
          }, HOLD_MS);
        }

        function layout() {
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          W = window.innerWidth;
          H = window.innerHeight;
          canvas.width = Math.round(W * dpr);
          canvas.height = Math.round(H * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          Rrest = Math.max(W, H) * 0.432;
          Rzoom = Math.max(W, H) * 3; // close-up at load
          R = Rrest;
          cx = W * 0.66;
          cy = H * 0.47; // lower the globe so the south pole / tip of Chile sit off-frame
        }

        function project(lon, lat) {
          const l = (lon - lam) * DEG;
          const p = lat * DEG;
          const cosp = Math.cos(p);
          const z = sinP * Math.sin(p) + cosP * cosp * Math.cos(l);
          const x = cx + R * (cosp * Math.sin(l));
          const y = cy - R * (cosP * Math.sin(p) - sinP * cosp * Math.cos(l));
          return { x, y, z };
        }

        function drawRings(rings, alpha) {
          ctx.lineWidth = 1;
          ctx.strokeStyle = `rgba(${BLUE},${alpha})`;
          for (const ring of rings) {
            let pen = false;
            ctx.beginPath();
            for (let i = 0; i < ring.length; i++) {
              const p = project(ring[i][0], ring[i][1]);
              if (p.z >= 0) {
                if (!pen) {
                  ctx.moveTo(p.x, p.y);
                  pen = true;
                } else ctx.lineTo(p.x, p.y);
              } else pen = false;
            }
            ctx.stroke();
          }
        }

        function strokePath(points, step, latLine) {
          let pen = false;
          ctx.beginPath();
          for (let i = 0; i < points.length; i++) {
            const p = latLine
              ? project(points[i], step)
              : project(step, points[i]);
            if (p.z >= 0) {
              if (!pen) {
                ctx.moveTo(p.x, p.y);
                pen = true;
              } else ctx.lineTo(p.x, p.y);
            } else pen = false;
          }
          ctx.stroke();
        }

        function frame(now) {
          const dt = now - last;
          last = now;

          if (introStart === null) introStart = now;
          const it = now - introStart;
          if (introOn && it < HOLD_MS) {
            // hold: zoomed in + centered on the visitor while the label types
            R = Rzoom;
            phi = phiFrom;
            lam = lamFrom;
          } else if (introOn && it < HOLD_MS + INTRO_MS) {
            const e = easeInOut((it - HOLD_MS) / INTRO_MS);
            R = Rzoom + (Rrest - Rzoom) * e;
            phi = phiFrom + (PHI_REST - phiFrom) * e;
            lam = lamFrom + shortDelta(lamFrom, LAM_REST) * e;
          } else {
            R = Rrest;
            phi = PHI_REST;
            if (!reduce) lam -= dt * 0.0035;
          }
          sinP = Math.sin(phi);
          cosP = Math.cos(phi);

          ctx.clearRect(0, 0, W, H);

          // graticule
          ctx.lineWidth = 1;
          ctx.strokeStyle = `rgba(${BLUE},0.14)`;
          for (let lon = -180; lon < 180; lon += 13) {
            const lats = [];
            for (let la = -80; la <= 80; la += 3) lats.push(la);
            strokePath(lats, lon, false);
          }
          for (let la = -78; la <= 78; la += 13) {
            const lons = [];
            for (let lo = -180; lo <= 180; lo += 3) lons.push(lo);
            strokePath(lons, la, true);
          }

          // country borders + continent outlines, drawn at the same weight so
          // every coastline/border line reads with one consistent thickness.
          drawRings(countryRings, 0.5);
          drawRings(continentRings, 0.5);

          // pulsing marker at the visitor's IP location
          if (hasIp) {
            const p = project(ipLon, ipLat);
            if (p.z >= 0) {
              if (!reduce) {
                const phase = (now % 2200) / 2200;
                ctx.beginPath();
                ctx.arc(p.x, p.y, 4 + phase * 20, 0, Math.PI * 2);
                ctx.strokeStyle = `rgba(${BLUE},${0.5 * (1 - phase)})`;
                ctx.lineWidth = 1.5;
                ctx.stroke();
              }
              ctx.beginPath();
              ctx.arc(p.x, p.y, 4, 0, Math.PI * 2);
              ctx.fillStyle = `rgb(${BLUE})`;
              ctx.fill();
            }
            // Pin the annotation to the dot's live screen position so it tracks
            // the dot (and stays attached) as the globe zooms out and rotates.
            if (annotEl) {
              if (p.z >= 0) {
                annotEl.style.left = p.x + "px";
                annotEl.style.top = p.y + "px";
                annotEl.style.visibility = "";
              } else {
                annotEl.style.visibility = "hidden";
              }
            }
          }

          requestAnimationFrame(frame);
        }

        layout();
        window.addEventListener("resize", layout);
        Promise.all([
          fetch("/data/countries.json").then((r) => r.json()),
          fetch("/data/land.json").then((r) => r.json()),
        ]).then(([c, l]) => {
          countryRings = c;
          continentRings = l;
          requestAnimationFrame(frame);
        });
      }
    </script>
  </body>
</html>

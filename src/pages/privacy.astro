---
import Base from "../layouts/Base.astro";

const description =
  "Privacy policy for Vishnu Bharath's personal website.";
---

<Base title="Privacy Policy — Vishnu Bharath" description={description} back>
  <header>
    <h1>Privacy Policy</h1>
    <p class="tagline">Last updated June 12, 2026</p>
  </header>

  <main>
    <article class="entry intro">
      <p>
        This personal website is designed to share my work, projects, writing,
        and background. It does not ask you to create an account or submit
        personal information through a form.
      </p>

      <h2>Information Collected</h2>
      <p>
        If you contact me by email or through an external profile linked from
        this site, I may receive the information you choose to send. The site
        may also be served by hosting providers that process basic technical
        data, such as IP address, browser type, pages requested, and timestamps,
        to deliver and protect the site.
      </p>

      <h2>Use of Information</h2>
      <p>
        Information you send directly is used to respond to your message. Basic
        technical data may be used for security, reliability, analytics, and
        site maintenance.
      </p>

      <h2>Third-Party Links</h2>
      <p>
        This site links to services such as GitHub, LinkedIn, and email. Those
        services have their own privacy practices, and this policy does not
        cover their websites or platforms.
      </p>

      <h2>Contact</h2>
      <p>
        For privacy questions, email
        <a href="mailto:mr.vishnubharath@gmail.com"
          >mr.vishnubharath@gmail.com</a
        >.
      </p>
    </article>
  </main>
</Base>

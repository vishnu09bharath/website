---
import Base from "../../layouts/Base.astro";
// Written by the sync workflow in the vishnu09bharath/resume repo alongside
// public/resume.pdf — don't edit by hand.
import resume from "../../data/resume.json";

const [year, month, day] = resume.date.split("-");
const resumeLabel = `${month}.${day}.${year.slice(2)}`;

const description =
  "Work by Vishnu Bharath across robotics research, FRC, publications, AI, and student-led ventures.";

const sections = [
  {
    href: "/work/media-lab/",
    title: "MIT Media Lab — City Science",
    time: "2024 – Present",
    blurb: "RL control and human-robot interaction for last-meter delivery robots.",
  },
  {
    href: "/work/frc/",
    title: "FRC Team 9644",
    time: "2023 – Present",
    blurb: "Co-founder, captain & driver. 2026 New England Champions.",
  },
];
---

<Base title="Work — Vishnu Bharath" description={description} back backLabel="Home">
  <header>
    <h1>Work</h1>
    <p class="tagline">stuff i've done</p>
  </header>

  <main>
    <div class="publication-layout">
      <div class="publication-main">
        <nav class="cards" aria-label="Work">
          {
            sections.map((s) => (
              <a class="card" href={s.href}>
                <div class="entry-head">
                  <h3>{s.title}</h3>
                  <time>{s.time}</time>
                </div>
                <p>{s.blurb}</p>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            ))
          }
        </nav>

        <h2>Publications</h2>

        <article class="entry">
          <div class="entry-head">
            <h3>
              <a href="/work/robot-body-language/"
                >Do Robots Need Body Language? Comparing Communication
                Modalities for Legible Motion Intent in Human-Shared Spaces</a
              >
            </h3>
            <time>2026</time>
          </div>
          <p class="pub-authors">
            J. Cohen, K. Shimizu, <strong>V. Bharath</strong>, Y. Song, K.
            Larson, P. Maes
          </p>
          <p class="pub-authors">ACM/IEEE HRI ’26</p>
        </article>
      </div>

      <aside class="publication-sidebar resume-sidebar" aria-label="Résumé">
        <dl>
          <div>
            <dt>Résumé</dt>
            <dd><a href="/resume.pdf" target="_blank" rel="noopener">PDF ({resumeLabel})</a></dd>
          </div>
        </dl>
      </aside>
    </div>
  </main>
</Base>
